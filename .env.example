# Novaris environment example
# Copy to .env for local development. Never commit real secret values.

PORT=8080

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Use one server-side admin key variable. SUPABASE_SECRET_KEY is preferred.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
# SUPABASE_SERVICE_ROLE_KEY=YOUR_LEGACY_SERVICE_ROLE_KEY

OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-5-mini

NOVARIS_CLOUD_NAME=Gaming PC
NOVARIS_CLOUD_BASE_URL=https://vnc.fuzzthehuzz-ebsfiygfhsvfbfesg.com
