# Novaris environment example
# Copy to .env for local development. Never commit real secret values.

PORT=8080

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Use one server-side admin key variable. SUPABASE_SECRET_KEY is preferred.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
# SUPABASE_SERVICE_ROLE_KEY=YOUR_LEGACY_SERVICE_ROLE_KEY

OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-5-mini

NOVARIS_CLOUD_NAME=Gaming PC
NOVARIS_CLOUD_BASE_URL=https://vnc.fuzzthehuzz-ebsfiygfhsvfbfesg.com

# Cloud Browser: separate from the legacy /cloud remote-PC integration.
# Run Novaris as one Node process on the dedicated Linux Docker host.
CLOUD_BROWSER_ENABLED=false
CLOUD_BROWSER_PUBLIC_ORIGIN=https://YOUR_NOVARIS_HOSTNAME
# Pin a tested image digest after pulling it; see docs/CLOUD-BROWSER.md.
CLOUD_BROWSER_IMAGE=
CLOUD_BROWSER_NETWORK_READY=false
CLOUD_BROWSER_MAX_SESSIONS=2
CLOUD_BROWSER_IDLE_SECONDS=180

# Rammerhead runs as a separate Node service (see docs/RAMMERHEAD.md).
RAMMERHEAD_API_URL=
RAMMERHEAD_PUBLIC_URL=
RAMMERHEAD_PASSWORD=

# Use header for the bundled Cloud Run backend; query for the original upstream.
RAMMERHEAD_AUTH_MODE=query
